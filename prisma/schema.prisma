datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  role         String        @default("USER") // USER or ADMIN
  eloRating    Int           @default(1000)
  mcqEloRating Int           @default(1000)
  createdAt    DateTime      @default(now())
  
  // Relations — Code Battle
  matchesAsWinner  Match[]    @relation("WinnerRelation")
  matchesAsPlayer1 Match[]    @relation("Player1Relation")
  matchesAsPlayer2 Match[]    @relation("Player2Relation")
  submissions      Submission[]

  // Relations — MCQ Battle
  mcqMatchesAsPlayer1 McqMatch[] @relation("McqPlayer1Relation")
  mcqMatchesAsPlayer2 McqMatch[] @relation("McqPlayer2Relation")
  mcqMatchesAsWinner  McqMatch[] @relation("McqWinnerRelation")

  // Relations — Admin MCQ Questions
  mcqQuestionsCreated McqQuestion[]

  // Relations — Rooms
  roomsCreated     Room[]             @relation("RoomCreator")
  roomParticipants RoomParticipant[]
}

model Problem {
  id           String        @id @default(uuid())
  title        String
  description  String
  difficulty   String        // EASY, MEDIUM, HARD, BOSS
  basePoints   Int
  timeLimitSec Int           @default(2)
  memoryLimitMb Int          @default(128)
  
  // Relations
  testCases    TestCase[]
  submissions  Submission[]
}

model TestCase {
  id           String        @id @default(uuid())
  problemId    String
  input        String
  expected     String
  isPublic     Boolean       @default(false)
  
  // Relations
  problem      Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Match {
  id           String        @id @default(uuid())
  player1Id    String
  player2Id    String
  winnerId     String?
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  status       String        // ACTIVE, COMPLETED, ABANDONED
  player1Score Int           @default(0)
  player2Score Int           @default(0)
  
  // Relations
  player1      User          @relation("Player1Relation", fields: [player1Id], references: [id])
  player2      User          @relation("Player2Relation", fields: [player2Id], references: [id])
  winner       User?         @relation("WinnerRelation", fields: [winnerId], references: [id])
  submissions  Submission[]

  @@index([player1Id])
  @@index([player2Id])
  @@index([winnerId])
}

model Submission {
  id           String        @id @default(uuid())
  userId       String
  problemId    String
  matchId      String?       // Optional — null when submitted outside a live match
  code         String
  language     String        // PYTHON, CPP, JAVA
  status       String        // ACCEPTED, WRONG_ANSWER, TIME_LIMIT_EXCEEDED, RUNTIME_ERROR
  passedCount  Int
  totalCount   Int
  createdAt    DateTime      @default(now())

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem      Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  match        Match?        @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([problemId])
  @@index([matchId])
}

model McqMatch {
  id           String   @id @default(uuid())
  player1Id    String
  player2Id    String
  winnerId     String?
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  status       String   // ACTIVE, COMPLETED, ABANDONED
  player1Score Int      @default(0)
  player2Score Int      @default(0)
  totalRounds  Int      @default(10)

  // Relations
  player1 User  @relation("McqPlayer1Relation", fields: [player1Id], references: [id])
  player2 User  @relation("McqPlayer2Relation", fields: [player2Id], references: [id])
  winner  User? @relation("McqWinnerRelation", fields: [winnerId], references: [id])

  @@index([player1Id])
  @@index([player2Id])
  @@index([winnerId])
}

// ── Admin-managed MCQ Question Bank ──────────────────────────────
model McqQuestion {
  id           String   @id @default(uuid())
  question     String
  options      String[] // Array of 4 options
  correctIndex Int      // 0-3 index of correct option
  difficulty   String   // EASY, MEDIUM, HARD
  category     String   // "Data Structures", "Algorithms", "OOP", "Web Dev", etc.
  createdAt    DateTime @default(now())
  createdById  String?

  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([difficulty])
}

// ── Private Competition Rooms ────────────────────────────────────
model Room {
  id           String            @id @default(uuid())
  code         String            @unique  // e.g., "COSMO-A1B2"
  name         String                     // "Class 12 CS Competition"
  description  String?
  mode         String                     // "code" or "mcq"
  status       String            @default("WAITING") // WAITING, ACTIVE, COMPLETED
  maxPlayers   Int               @default(100)
  totalRounds  Int               @default(5)
  currentRound Int               @default(0)
  createdById  String
  createdAt    DateTime          @default(now())
  startedAt    DateTime?
  endedAt      DateTime?

  // Relations
  createdBy    User              @relation("RoomCreator", fields: [createdById], references: [id])
  participants RoomParticipant[]

  @@index([code])
  @@index([status])
}

model RoomParticipant {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  score     Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  rank      Int?
  isActive  Boolean  @default(true) // false = eliminated or left
  joinedAt  DateTime @default(now())

  // Relations
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

